# 复制为 variables.env 后填写真实值。variables.env 不提交进仓库。
# 本文件只含占位符示例。

INTERNAL_IF=eth0
INTERNAL_IP=<INTERNAL_IP>
INTERNAL_CIDR=<INTERNAL_CIDR>
INTERNAL_GW=<INTERNAL_GW>

PUBLIC_IF=eth1
PUBLIC_IP=<PUBLIC_IP>
PUBLIC_GW=<PUBLIC_GW>

# 逗号分隔，填本环境管理网段
MGMT_NETS=<MGMT_NETS>
# 可选：状态口 Auth 正则；不填时 render.py 按 /24 网段自动推导，非 /24 请显式填写
# MGMT_REGEX=<MGMT_REGEX>

MCU_SIGNAL_IP=<MCU_SIGNAL_IP>
MCU_ALIAS=<MCU_ALIAS>
LOCAL_PREFIX=<LOCAL_PREFIX>

# 只收不发端点（如录播）的媒体 IP，单列
RECORD_IP=<RECORD_IP>
# 集团 MCU IP，逗号分隔
GROUP_MCU_IPS=<GROUP_MCU_IPS>

WEB_BIND_IP=<INTERNAL_IP>
WEB_PORT=8090
GK_STATUS_PORT=7000
